# Local IDE state and machine-specific CMake presets.
/.idea/
/.vs/
/CMakeUserPresets.json
/*.vcxproj.user
/*.suo

# Out-of-source builds, staged assets, and local test packages.
/cmake-build-*/
/build/
/out/

# Generated files from an accidental in-source CMake/Ninja build.
/CMakeCache.txt
/CMakeFiles/
/CMakeScripts/
/_deps/
/Testing/
/CTestTestfile.cmake
/DartConfiguration.tcl
/cmake_install.cmake
/install_manifest.txt
/compile_commands.json
/build.ninja
/rules.ninja
/.ninja_deps
/.ninja_log

# Root-level projects generated by CMake's Visual Studio generator.
/*.sln
/*.vcxproj
/*.vcxproj.filters

# Windows Explorer metadata.
Thumbs.db
Desktop.ini

# Keep shared CMakePresets.json, vendor/lib dependencies, game assets,
# and docs/**/evidence files visible. Do not ignore their extensions globally.
